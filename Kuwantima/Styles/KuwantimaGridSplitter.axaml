<Styles xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20" Width="600" Height="400">
			<Grid ColumnDefinitions="*, *">
				<!-- LEFT SIDE: LIGHT THEME PREVIEW -->
				<ThemeVariantScope RequestedThemeVariant="Light" Grid.Column="0">
					<Border Background="{DynamicResource SystemRegionBrush}" Classes="KuwantimaGlass" Padding="0" ClipToBounds="True">
						<Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*">
							<TextBlock Text="Light Theme" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"
							           Grid.ColumnSpan="3" Margin="0,12,0,8"/>

							<!-- Vertical splitter demo -->
							<Border Grid.Row="1" Grid.Column="0" Padding="12">
								<TextBlock Text="Left Panel" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
							</Border>

							<GridSplitter Classes="Kuwantima" Grid.Row="1" Grid.Column="1"/>

							<Border Grid.Row="1" Grid.Column="2">
								<Grid RowDefinitions="*,Auto,*">
									<Border Padding="12">
										<TextBlock Text="Top Right" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
									</Border>

									<GridSplitter Classes="Kuwantima Horizontal" Grid.Row="1"/>

									<Border Grid.Row="2" Padding="12">
										<TextBlock Text="Bottom Right" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
									</Border>
								</Grid>
							</Border>
						</Grid>
					</Border>
				</ThemeVariantScope>

				<!-- RIGHT SIDE: DARK THEME PREVIEW -->
				<ThemeVariantScope RequestedThemeVariant="Dark" Grid.Column="1">
					<Border Background="{DynamicResource SystemRegionBrush}" Classes="KuwantimaGlass" Padding="0" ClipToBounds="True">
						<Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*">
							<TextBlock Text="Dark Theme" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"
							           Grid.ColumnSpan="3" Margin="0,12,0,8"/>

							<!-- Vertical splitter demo -->
							<Border Grid.Row="1" Grid.Column="0" Padding="12">
								<TextBlock Text="Left Panel" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
							</Border>

							<GridSplitter Classes="Kuwantima" Grid.Row="1" Grid.Column="1"/>

							<Border Grid.Row="1" Grid.Column="2">
								<Grid RowDefinitions="*,Auto,*">
									<Border Padding="12">
										<TextBlock Text="Top Right" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
									</Border>

									<GridSplitter Classes="Kuwantima Horizontal" Grid.Row="1"/>

									<Border Grid.Row="2" Padding="12">
										<TextBlock Text="Bottom Right" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
									</Border>
								</Grid>
							</Border>
						</Grid>
					</Border>
				</ThemeVariantScope>
			</Grid>
		</Border>
	</Design.PreviewWith>

	<!-- ═══ BASE: GridSplitter.Kuwantima (Vertical — between columns) ═══ -->
	<Style Selector="GridSplitter.Kuwantima">
		<Setter Property="Background" Value="{DynamicResource KuwantimaGlassGlowBorder}"/>
		<Setter Property="Width" Value="1.5"/>
		<Setter Property="MinWidth" Value="6"/>
		<Setter Property="Cursor" Value="SizeWestEast"/>
		<Setter Property="Margin" Value="0"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent">
					<!-- Thin visible line, centered in the hit-test area -->
					<Border Name="SplitterLine"
					        Background="{TemplateBinding Background}"
					        Width="1.5"
					        HorizontalAlignment="Center"
					        VerticalAlignment="Stretch"
					        CornerRadius="1">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.2"/>
							</Transitions>
						</Border.Transitions>
					</Border>
				</Border>
			</ControlTemplate>
		</Setter>

		<!-- Hover -->
		<Style Selector="^:pointerover /template/ Border#SplitterLine">
			<Setter Property="Background" Value="{DynamicResource KuwantimaGlassGlowBorderHover}"/>
			<Setter Property="Width" Value="2.5"/>
		</Style>

		<!-- Dragging -->
		<Style Selector="^:pressed /template/ Border#SplitterLine">
			<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
			<Setter Property="Width" Value="2.5"/>
		</Style>
	</Style>

	<!-- ═══ HORIZONTAL: GridSplitter.Kuwantima.Horizontal (between rows) ═══ -->
	<Style Selector="GridSplitter.Kuwantima.Horizontal">
		<Setter Property="Width" Value="NaN"/>
		<Setter Property="Height" Value="1.5"/>
		<Setter Property="MinHeight" Value="6"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="Cursor" Value="SizeNorthSouth"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent">
					<Border Name="SplitterLine"
					        Background="{TemplateBinding Background}"
					        Height="1.5"
					        VerticalAlignment="Center"
					        HorizontalAlignment="Stretch"
					        CornerRadius="1">
						<Border.Transitions>
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.2"/>
							</Transitions>
						</Border.Transitions>
					</Border>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Horizontal hover -->
	<Style Selector="GridSplitter.Kuwantima.Horizontal:pointerover /template/ Border#SplitterLine">
		<Setter Property="Background" Value="{DynamicResource KuwantimaGlassGlowBorderHover}"/>
		<Setter Property="Height" Value="2.5"/>
	</Style>

	<!-- Horizontal dragging -->
	<Style Selector="GridSplitter.Kuwantima.Horizontal:pressed /template/ Border#SplitterLine">
		<Setter Property="Background" Value="{DynamicResource KuwantimaAccentOrangeBrush}"/>
		<Setter Property="Height" Value="2.5"/>
	</Style>
</Styles>
