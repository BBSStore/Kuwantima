<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kuwantima.Sandbox.ViewModels"
        xmlns:pages="using:Kuwantima.Sandbox.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Kuwantima.Sandbox.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Kuwantima Style Sandbox"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Root glass container -->
    <Border Classes="KuwantimaGlass" Margin="8" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

            <!-- HEADER -->
            <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource KuwantimaGlassBackground}">
                <Grid ColumnDefinitions="Auto,8,Auto,12,*,Auto">
                    <!-- Pane toggle -->
                    <Button Classes="Kuwantima Minimal"
                            Command="{Binding TogglePaneCommand}"
                            ToolTip.Tip="Toggle navigation pane"
                            Width="36" Height="36">
                        <PathIcon Data="{StaticResource Icon.Sliders}" Width="16" Height="16"/>
                    </Button>

                    <!-- Theme toggle -->
                    <ToggleButton Grid.Column="2" Classes="KuwantimaMenu"
                                  Content="Theme"
                                  IsChecked="{Binding IsDarkTheme}"
                                  ToolTip.Tip="Toggle light/dark theme">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton">
                                <Setter Property="Tag" Value="{DynamicResource Icon.Sun}"/>
                            </Style>
                            <Style Selector="ToggleButton:checked">
                                <Setter Property="Tag" Value="{DynamicResource Icon.Moon.ThirdEye.Smiling}"/>
                            </Style>
                        </ToggleButton.Styles>
                    </ToggleButton>

                    <TextBlock Grid.Column="4" Text="Kuwantima Style Sandbox"
                               FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="Kuwantima Accent" Content="Accent"/>
                        <Button Classes="Kuwantima" Content="Standard"/>
                        <Button Classes="Kuwantima Minimal">
                            <PathIcon Data="{StaticResource Icon.Gear}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SPLITVIEW -->
            <SplitView Grid.Row="1"
                       IsPaneOpen="{Binding IsPaneOpen}"
                       DisplayMode="CompactInline"
                       CompactPaneLength="56"
                       OpenPaneLength="220"
                       PaneBackground="Transparent">

                <SplitView.Pane>
                    <Border Padding="4,8,4,8">
                        <StackPanel Spacing="4">
                                <ToggleButton Classes="KuwantimaMenu"
                                              Classes.Expanded="{Binding IsPaneOpen}"
                                              Tag="{StaticResource Icon.Home}"
                                              Content="Buttons"
                                              IsChecked="{Binding IsButtonsPageVisible, Mode=OneWay}"
                                              Command="{Binding NavigateToCommand}"
                                              CommandParameter="0"/>
                                <ToggleButton Classes="KuwantimaMenu"
                                              Classes.Expanded="{Binding IsPaneOpen}"
                                              Tag="{StaticResource Icon.Search}"
                                              Content="Inputs"
                                              IsChecked="{Binding IsInputsPageVisible, Mode=OneWay}"
                                              Command="{Binding NavigateToCommand}"
                                              CommandParameter="1"/>
                                <ToggleButton Classes="KuwantimaMenu"
                                              Classes.Expanded="{Binding IsPaneOpen}"
                                              Tag="{StaticResource Icon.Sliders}"
                                              Content="Toggles"
                                              IsChecked="{Binding IsTogglesPageVisible, Mode=OneWay}"
                                              Command="{Binding NavigateToCommand}"
                                              CommandParameter="2"/>
                                <ToggleButton Classes="KuwantimaMenu"
                                              Classes.Expanded="{Binding IsPaneOpen}"
                                              Tag="{StaticResource Icon.Layers}"
                                              Content="Feedback"
                                              IsChecked="{Binding IsFeedbackPageVisible, Mode=OneWay}"
                                              Command="{Binding NavigateToCommand}"
                                              CommandParameter="3"/>
                                <ToggleButton Classes="KuwantimaMenu"
                                              Classes.Expanded="{Binding IsPaneOpen}"
                                              Tag="{StaticResource Icon.Map}"
                                              Content="Containers"
                                              IsChecked="{Binding IsContainersPageVisible, Mode=OneWay}"
                                              Command="{Binding NavigateToCommand}"
                                              CommandParameter="4"/>
                        </StackPanel>
                    </Border>
                </SplitView.Pane>

                <!-- PAGE CONTENT — all pages stay alive, visibility toggled -->
                <SplitView.Content>
                    <Panel Margin="4">
                        <pages:ButtonsPage IsVisible="{Binding IsButtonsPageVisible}"/>
                        <pages:InputsPage IsVisible="{Binding IsInputsPageVisible}"/>
                        <pages:TogglesPage IsVisible="{Binding IsTogglesPageVisible}"/>
                        <pages:FeedbackPage IsVisible="{Binding IsFeedbackPageVisible}"/>
                        <pages:ContainersPage IsVisible="{Binding IsContainersPageVisible}"/>
                    </Panel>
                </SplitView.Content>
            </SplitView>
        </Grid>
    </Border>
</Window>
